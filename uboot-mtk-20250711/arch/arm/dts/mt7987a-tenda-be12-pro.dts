/dts-v1/;
#include "mt7987a.dtsi"
#include "mt7987a-u-boot.dtsi"
#include "mt7987-netsys-u-boot.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "Tenda BE12 Pro";
	compatible = "tenda,be12-pro", "mediatek,mt7987a", "mediatek,mt7987";

	chosen {
		bootargs = "console=ttyS0,115200n1 loglevel=8 earlycon=uart8250,mmio32,0x11000000 pci=pcie_bus_perf ubi.block=0,firmware root=/dev/fit0 rootwait";
		stdout-path = "serial0:115200n1";
	};

	aliases {
		serial0 = &uart0;
		led-boot = &status_green;
		led-failsafe = &status_red;
		led-running = &status_green;
		led-upgrade = &status_red;
	};

	config {
		blink_led = "status:red";
		system_led = "status:green";
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
		};

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		status_green: status-green {
			label = "status:green";
			gpios = <&pio 6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		status_red: status-red {
			label = "status:red";
			gpios = <&pio 7 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};
};

&eth0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mdio0_pins>;
	phy-mode = "2500base-x";
	mediatek,switch = "an8855";
	reset-gpios = <&pio 42 GPIO_ACTIVE_HIGH>;

	fixed-link {
		speed = <2500>;
		full-duplex;
		pause;
	};
};

&eth1 {
	status = "okay";
	pinctrl-names = "i2p5gbe-led";
	pinctrl-0 = <&i2p5gbe_led0_pins>;
	phy-mode = "xgmii";
	phy-handle = <&phy15>;

	phy15: ethernet-phy@15 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <15>;
		phy-mode = "xgmii";
	};
};

&eth2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mdio0_pins>;
	phy-mode = "2500base-x";
	phy-handle = <&phy11>;

	fixed-link {
		speed = <2500>;
		full-duplex;
	};

	phy11: ethernet-phy@11 {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <11>;
		phy-mode = "2500base-x";
		reset-gpios = <&pio 48 GPIO_ACTIVE_LOW>;
		reset-assert-us = <100000>;
		reset-deassert-us = <100000>;
	};
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		mediatek,nmbm;
		mediatek,bmt-max-ratio = <1>;
		mediatek,bmt-max-reserved-blocks = <64>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "BL2";
				reg = <0x0000000 0x0100000>;
				read-only;
			};

			partition@100000 {
				label = "FIP";
				reg = <0x0100000 0x0200000>;
			};

			partition@300000 {
				label = "u-boot-env";
				reg = <0x0300000 0x0080000>;
			};

			factory: partition@380000 {
				label = "Factory";
				reg = <0x0380000 0x0400000>;
				read-only;
			};

			partition@780000 {
				label = "kernel";
				reg = <0x0780000 0x0600000>;
			};

			partition@d80000 {
				label = "ubi";
				reg = <0x0d80000 0x5a00000>;
				compatible = "linux,ubi";

				volumes {
					ubi_rootfs: ubi-volume-fit {
						volname = "firmware";
					};
				};
			};

			partition@6780000 {
				label = "CFG";
				reg = <0x6780000 0x0400000>;
				read-only;
			};

			partition@6b80000 {
				label = "MISC2";
				reg = <0x6b80000 0x0400000>;
				read-only;
			};
		};
	};
};
